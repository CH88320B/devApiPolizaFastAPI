# Domain
DOMAIN=localhost

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173

# Environment
ENVIRONMENT=local

# Proyecto
PROJECT_NAME="WebApiPolizasPython"
STACK_NAME=webapipolizas-python

AUTH0_DOMAIN=dev-x1b7vn3nax5lxkj0.us.auth0.com
AUTH0_API_AUDIENCE=https://fastapi-api
AUTH0_ALGORITHMS=RS256


# Backend CORS (esto puedes mantenerlo así para entorno local)
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Seguridad
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails (los puedes dejar así si no usarás SMTP por ahora)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Azure SQL Server en lugar de Postgres
AZURE_SQL_SERVER=XXXXX.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=
AZURE_SQL_DATABASE=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server


# No usar estas de Postgres, las puedes eliminar o comentar
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=app
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=changethis

# Sentry (opcional, para monitoreo de errores, puedes dejarlo vacío)
SENTRY_DSN=

# Docker Images (solo si haces deploy en docker)
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
